# Required. Secret used to sign/verify JWTs. Minimum 8 characters (see
# EnvironmentVariables), but use a long random value in any real deployment.
JWT_SECRET=change-me-to-a-long-random-secret

# Optional. HTTP port. Defaults to 3000 if unset.
PORT=3000

# Optional. JWT expiry in seconds. Defaults to '1h' if unset.
EXPIRATION_TIMER=3600
